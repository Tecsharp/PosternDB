# =============================================================================
#  PosternDB — configuración
#  Única fuente de configuración. Cópialo a .env (setup.sh lo hace solo) y
#  rellena la sección de Cloudflare. Nunca subas .env a git.
# =============================================================================

# ---------------------------------------------------------------------------
#  1. ADMINISTRADOR DEL PANEL
# ---------------------------------------------------------------------------

# Vacíos = setup.sh genera usuario y contraseña y los muestra una vez.
ADMIN_USER=
ADMIN_PASSWORD=

# Firma las sesiones del panel. Mínimo 32 caracteres.
# Vacío = setup.sh lo genera. Cambiarlo cierra la sesión de todos.
JWT_SECRET=

# ---------------------------------------------------------------------------
#  2. DOMINIO  (BASE_DOMAIN es obligatorio si no usas LOCAL_MODE)
#
#  Cada base se publica como:  <CLIENT_HOST_PREFIX><cliente>.<BASE_DOMAIN>
#
#  Dominio solo para PosternDB (p. ej. posterndb.com), con la raíz libre
#  para tu página:
#    BASE_DOMAIN=posterndb.com
#    CLIENT_HOST_PREFIX=                -> acme.posterndb.com
#    PANEL_HOSTNAME=app.posterndb.com
#
#  Dominio compartido con otras cosas (p. ej. midominio.com):
#    BASE_DOMAIN=midominio.com
#    CLIENT_HOST_PREFIX=postern-        -> postern-acme.midominio.com
#    PANEL_HOSTNAME=postern.midominio.com
#
#  ¿Por qué un prefijo y no acme.postern.midominio.com? El certificado
#  gratis de Cloudflare solo cubre UN nivel de subdominio (*.midominio.com).
#  Un segundo nivel necesita Advanced Certificate Manager (de pago).
#
#  Para cambiar de esquema más tarde: cambia estos valores, reinicia y
#  ejecuta `docker compose run --rm app migrate-hostnames`.
# ---------------------------------------------------------------------------

# Tu dominio. Sin https:// ni barra al final.
BASE_DOMAIN=

# Prefijo de los hosts de cliente. Puede ir vacío.
CLIENT_HOST_PREFIX=postern-

# Host del panel. Vacío = postern.<BASE_DOMAIN>
PANEL_HOSTNAME=

# ---------------------------------------------------------------------------
#  3. CLOUDFLARE  (obligatorio si no usas LOCAL_MODE)
# ---------------------------------------------------------------------------

# Token de API. dash.cloudflare.com -> Mi Perfil -> Tokens de API ->
# Crear Token -> Crear Token Personalizado, con estos permisos:
#   Zona    | DNS              | Editar   (Recursos de zona: tu dominio)
#   Cuenta  | Cloudflare Tunnel| Editar   (Recursos de cuenta: tu cuenta)
CLOUDFLARE_API_TOKEN=

# dash.cloudflare.com -> elige tu dominio -> General -> Zone ID (32 caracteres).
CLOUDFLARE_ZONE_ID=

# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared ->
# dale un nombre -> copia el token largo del paso de instalación (empieza
# con "eyJ"). NO agregues hostnames públicos ahí: PosternDB los crea solo.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
#  3a. CÓMO ENTRAN LOS USUARIOS REGISTRADOS (opcional)
#  El administrador siempre entra con su usuario y contraseña. Los usuarios
#  registrados pueden entrar con correo o usuario y contraseña, con Google, o
#  con las dos formas. Google también es su recuperación: quien olvide su
#  contraseña entra con Google y crea una nueva desde Seguridad.
#
#  AUTH_MODE:
#    password = solo correo/usuario y contraseña
#    google   = solo Google (necesita las dos variables de abajo)
#    both     = las dos formas (necesita las dos variables de abajo)
#  Vacío = "password", o "both" si llenas las credenciales de Google.
#
#  Una cuenta que ya existe con contraseña NO se abre con Google solo por
#  tener el mismo correo: su dueño la vincula a Google desde Seguridad.
#
#  Para usar Google:
#  1. console.cloud.google.com → crea un proyecto → "APIs y servicios" →
#     "Pantalla de consentimiento de OAuth" → Externo → nombre y correo.
#  2. "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth" →
#     "Aplicación web".
#  3. En "URI de redireccionamiento autorizados" agrega EXACTAMENTE:
#       https://app.posterndb.com/api/auth/google/callback
#     (tu PANEL_HOSTNAME; en LOCAL_MODE: http://localhost:28437/api/auth/google/callback)
#  4. Copia aquí el ID de cliente y el secreto.
# ---------------------------------------------------------------------------
AUTH_MODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo si Google debe volver a una dirección distinta. Vacío = automática.
GOOGLE_REDIRECT_URL=

# ---------------------------------------------------------------------------
#  3b. MODO LOCAL (opcional)
#  true = sin Cloudflare. Ignora las secciones 2 y 3; las bases solo se ven
#  en 127.0.0.1:LOCAL_DB_PORT de esta máquina. Útil para desarrollo.
# ---------------------------------------------------------------------------

LOCAL_MODE=false
LOCAL_DB_PORT=25432

# ---------------------------------------------------------------------------
#  4. INACTIVIDAD Y RESPALDOS
#  Esto es solo el valor inicial: el propietario del panel lo cambia luego
#  sin reiniciar, desde Ajustes → Expiración.
# ---------------------------------------------------------------------------

# Días sin conexión antes de que una base expire.
DB_EXPIRATION_DAYS=30

# Días antes de expirar en que el panel avisa "Por expirar".
EXPIRING_SOON_DAYS=7

# Cada cuántas horas se revisa la inactividad.
CHECK_INTERVAL_HOURS=6

# true  = al expirar o eliminar, se respalda y luego se borra.
# false = al expirar o eliminar, se borra de inmediato (sin vuelta atrás).
BACKUP_BEFORE_DELETE=true

# Cada cuántos segundos el sidecar revisa trabajos pendientes (respaldos,
# restauraciones, clonaciones).
BACKUP_POLL_SECONDS=5

# ---------------------------------------------------------------------------
#  4a. USUARIOS REGISTRADOS
#  Cualquiera puede crear su cuenta en la pantalla de acceso y administrar
#  sus propias bases (sin consola SQL). Su expiración la fija el propietario
#  desde el panel: global o por usuario.
# ---------------------------------------------------------------------------

# true = se muestra "Crear cuenta" en el acceso. false = solo cuentas creadas
# por el propietario.
ALLOW_SELF_REGISTER=true

# Bases de datos que puede crear cada usuario registrado.
MAX_DATABASES_PER_CLIENT=3

# ---------------------------------------------------------------------------
#  4b. NOTIFICACIONES (opcional)
#  Avisan antes de que una base expire. Vacío = desactivado.
# ---------------------------------------------------------------------------

# Webhook de Discord o Slack (o cualquier endpoint que reciba JSON).
NOTIFY_WEBHOOK_URL=

# Destinatarios de correo, separados por coma. Necesita los SMTP_* de abajo.
NOTIFY_EMAIL_TO=

SMTP_HOST=
# 587 = STARTTLS, 465 = TLS directo.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
#  5. POSTGRES DE LA PLATAFORMA  (interno, nunca expuesto)
#  Aviso: la contraseña solo se aplica al crear el volumen de datos por
#  primera vez. Cambiarla después requiere ALTER ROLE dentro de la base.
# ---------------------------------------------------------------------------

POSTGRES_USER=posterndb

# Vacío = setup.sh la genera.
POSTGRES_PASSWORD=

POSTGRES_DB=posterndb

# ---------------------------------------------------------------------------
#  6. OPCIONAL
# ---------------------------------------------------------------------------

# Puerto del panel en esta máquina: http://127.0.0.1:28437
# Elegido para no chocar con otros servicios. Cámbialo si ya está en uso.
PANEL_LOCAL_PORT=28437

# Puerto local que se muestra en las instrucciones de conexión del cliente
# (cloudflared access tcp --url localhost:PUERTO).
CLIENT_LOCAL_PORT=5432
