# =============================================================================
#  PosternDB — configuration
#  This file is the ONLY source of configuration. Copy it to .env (setup.sh
#  does it for you) and fill in the Cloudflare section. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. Panel administrator
#  Leave empty: ./setup.sh generates secure values and prints them once.
# -----------------------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=
# Secret used to sign panel sessions (JWT, HS256). >= 32 characters.
# Leave empty: setup generates it. Changing it logs everyone out.
JWT_SECRET=

# -----------------------------------------------------------------------------
#  2. Domain and hostname scheme   (REQUIRED: BASE_DOMAIN)
#
#  Client databases are published as:
#      <CLIENT_HOST_PREFIX><client>.<BASE_DOMAIN>
#
#  Shared domain (e.g. pachislab.com, used for other things too):
#      BASE_DOMAIN=pachislab.com
#      CLIENT_HOST_PREFIX=postern-        -> postern-acme.pachislab.com
#      PANEL_HOSTNAME=postern.pachislab.com
#
#  Dedicated domain (e.g. posterndb.com):
#      BASE_DOMAIN=posterndb.com
#      CLIENT_HOST_PREFIX=                -> acme.posterndb.com
#      PANEL_HOSTNAME=posterndb.com
#
#  Why a prefix instead of acme.postern.pachislab.com? Cloudflare's free
#  Universal SSL certificate covers only ONE subdomain level (*.pachislab.com).
#  A second level would need Advanced Certificate Manager (paid).
#
#  Switching schemes later: change these values, restart, then run
#      docker compose run --rm app migrate-hostnames --dry-run
#      docker compose run --rm app migrate-hostnames
# -----------------------------------------------------------------------------
BASE_DOMAIN=
CLIENT_HOST_PREFIX=postern-
# Empty = postern.<BASE_DOMAIN>
PANEL_HOSTNAME=

# -----------------------------------------------------------------------------
#  3. Cloudflare   (REQUIRED)
#
#  CLOUDFLARE_API_TOKEN
#    dash.cloudflare.com -> My Profile -> API Tokens -> Create Token ->
#    "Create Custom Token" with these permissions:
#       Zone    | DNS               | Edit     (Zone Resources: your domain)
#       Account | Cloudflare Tunnel | Edit     (Account Resources: your account)
#    Example value: 4Gk3...(40 chars)
#
#  CLOUDFLARE_ZONE_ID
#    dash.cloudflare.com -> select your domain -> Overview -> right column
#    "API" section -> Zone ID (32 hex characters).
#
#  CLOUDFLARE_TUNNEL_TOKEN
#    Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel ->
#    "Cloudflared" -> name it (e.g. posterndb) -> on the install step copy the
#    long token after `cloudflared service install` (starts with "eyJ").
#    Do NOT add public hostnames there: PosternDB manages them via the API.
#    The account and tunnel IDs are read from this token automatically.
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
#  3b. Local mode (optional)
#  true = run without Cloudflare: section 2 and 3 are ignored and databases
#  are reachable only from this machine on 127.0.0.1:LOCAL_DB_PORT.
#  Handy for development. Switch back to false to publish through the tunnel.
# -----------------------------------------------------------------------------
LOCAL_MODE=false
LOCAL_DB_PORT=25432

# -----------------------------------------------------------------------------
#  4. Inactivity policy
# -----------------------------------------------------------------------------
# Days without any connection after which a client database expires.
DB_EXPIRATION_DAYS=30
# Days before expiry in which the panel shows "Por expirar".
EXPIRING_SOON_DAYS=7
# How often the inactivity audit runs (hours).
CHECK_INTERVAL_HOURS=6
# true  = expired/deleted DBs are dumped to the "backups" volume, then dropped.
# false = expired/deleted DBs are dropped immediately (irreversible).
BACKUP_BEFORE_DELETE=true
# How often the backup sidecar checks for queued jobs: backups, restores,
# clones (seconds). Replaces the old BACKUP_INTERVAL_SECONDS, now ignored.
BACKUP_POLL_SECONDS=5

# -----------------------------------------------------------------------------
#  4b. Notifications (optional): warnings before a database expires.
#  Leave empty to disable. Webhook works with Discord and Slack incoming
#  webhooks (or any endpoint that accepts JSON).
# -----------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=
# Comma separated recipients; needs the SMTP_* settings below.
NOTIFY_EMAIL_TO=
SMTP_HOST=
# 587 = STARTTLS, 465 = TLS
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
#  5. Platform PostgreSQL (internal only, never exposed to the host)
#  Leave POSTGRES_PASSWORD empty: setup generates it.
#  WARNING: the password is applied only when the data volume is first
#  created. Changing it later requires ALTER ROLE inside the database.
# -----------------------------------------------------------------------------
POSTGRES_USER=posterndb
POSTGRES_PASSWORD=
POSTGRES_DB=posterndb

# -----------------------------------------------------------------------------
#  6. Optional
# -----------------------------------------------------------------------------
# Loopback port for local panel access: http://127.0.0.1:28437
# Deliberately uncommon (and below the OS ephemeral port ranges) so it does
# not clash with other local services. Change it if something else uses it.
PANEL_LOCAL_PORT=28437
# Local port shown in client instructions (cloudflared access tcp --url).
CLIENT_LOCAL_PORT=5432
